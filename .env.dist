# =============================================================================
# E-commerce Microservices - Environment Variables Template
# Copy this file to .env and fill in the values.
# The .env file is gitignored and should NEVER be committed.
# =============================================================================

# --- Database Configuration (PostgreSQL) ---
# Used by: user-service, product-service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=admin
DB_PASSWORD=admin

# For Docker Compose compatibility
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=ecommerce_db

# --- MongoDB Configuration ---
# Used by: order-service
MONGO_URI=mongodb://localhost:27017/orders_db

# --- Redis Configuration ---
# Used by: order-service (cart), product-service (cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ Configuration ---
# Used by: order-service (publisher), notification-service (consumer)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- JWT Configuration ---
# Used by: user-service (sign), api-gateway (verify)
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=mySecretKeyMySecretKeyMySecretKeyMySecretKey

# --- SMTP / Mail Configuration ---
# Used by: notification-service
# For local dev, MailHog is configured at port 1025 (no auth needed)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=ecommerce@test.com
SMTP_PASSWORD=

# --- Mercado Pago Configuration ---
# Used by: order-service (payment processing)
MP_PUBLIC_KEY=TEST-your-public-key-here
MP_ACCESS_TOKEN=TEST-your-access-token-here
MP_NOTIFICATION_URL=http://localhost:8084/api/v1/payments/webhook
MP_SUCCESS_URL=http://localhost:3000/payment/success
MP_FAILURE_URL=http://localhost:3000/payment/failure
MP_PENDING_URL=http://localhost:3000/payment/pending

# --- Melhor Envio Configuration ---
# Used by: order-service (shipping calculation)
MELHOR_ENVIO_TOKEN=YOUR_MOCK_TOKEN

# --- Service Ports ---
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
GATEWAY_PORT=8080

# --- Inter-Service URLs ---
# Used by: order-service (calls product-service via Feign)
PRODUCT_SERVICE_URL=http://localhost:8082
# Used by: api-gateway routing
USER_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8083

# --- Cart TTL ---
CART_TTL_DAYS=7
